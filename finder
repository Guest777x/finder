local function readRange()
    local a = math.clamp(math.floor(tonumber(minBox.Text) or 1), 1, 100)
    local b = math.clamp(math.floor(tonumber(maxBox.Text) or 2), 1, 100)
    if b < a then a, b = b, a end
    minBox.Text, maxBox.Text = tostring(a), tostring(b)
    return a, b
end

-- ============================================================
-- HOP LOGIC
-- ============================================================
local busy = false
local joinFailed = false
TeleportService.TeleportInitFailed:Connect(function(player) if player == LocalPlayer then joinFailed = true end end)

local function shuffle(t)
    for i = #t, 2, -1 do local j = math.random(i); t[i], t[j] = t[j], t[i] end
    return t
end

local function hop()
    if busy then return end
    busy = true
    hopBtn.Text = "SCANNING..."
    local minP, maxP = readRange()
    local found, cursor, pages, scanned = {}, nil, 0, 0
    while pages < MAX_PAGES do
        pages += 1
        setStatus(("scanning page %d  -  %d servers checked, %d match"):format(pages, scanned, #found))
        local data, err = fetchPage(cursor)
        if not data then
            if #found == 0 then setStatus(err or "couldn't read the server list", C.RED); hopBtn.Text = "HOP NOW"; busy = false; return end
            break
        end
        scanned += #(data.data or {})
        for _, s in ipairs(pickServers(data.data, minP, maxP, game.JobId, visited, os.time())) do found[#found + 1] = s end
        local list = data.data or {}
        local lastPlaying = list[#list] and tonumber(list[#list].playing) or 0
        if #found >= 25 or not data.nextPageCursor or lastPlaying > maxP then break end  -- sorted ascending: past maxP, nothing more to find
        cursor = data.nextPageCursor
        task.wait(0.35)
    end
    if #found == 0 then
        setStatus(("no %d-%d player servers right now (%d checked), try again"):format(minP, maxP, scanned), C.RED)
        hopBtn.Text = "HOP NOW"; busy = false; return
    end
    shuffle(found)
    for i, s in ipairs(found) do
        hopBtn.Text = "JOINING..."
        setStatus(("found %d  -  joining server %d/%d  (%d players)"):format(#found, i, #found, tonumber(s.playing) or 0), C.GREEN)
        visited[s.id] = os.time(); saveVisited()
        joinFailed = false
        local ok = pcall(function() TeleportService:TeleportToPlaceInstance(PLACE_ID, s.id, LocalPlayer) end)
        local t0 = os.clock()
        while ok and not joinFailed and os.clock() - t0 < JOIN_TIMEOUT do task.wait(0.25) end
        -- still here after the timeout / a failure: that one was full or gone, try the next
        setStatus("that one fell through, trying the next", C.GOLD)
        task.wait(0.4)
    end
    setStatus("every match fell through, hit HOP NOW again", C.RED)
    hopBtn.Text = "HOP NOW"; busy = false
end
