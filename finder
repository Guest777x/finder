-- ============================================================
local PLACE_ID_OVERRIDE = nil   -- put the game's place id here to hop in a different place; nil = this game
local PLACE_ID    = PLACE_ID_OVERRIDE or game.PlaceId
local MAX_PAGES   = 12          -- 12 x 100 servers per search, lowest player counts first
local VISIT_TTL   = 1800        -- don't rejoin a server you hopped into in the last 30 min
local JOIN_TIMEOUT = 14         -- seconds to wait for a teleport before trying the next server
local FOLDER      = "IdontlogHopper"
local VISITED_FILE = FOLDER .. "/visited.json"

local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
local HOSTS = { "games.roblox.com", "games.roproxy.com" }

local function hasFS() return writefile and readfile and isfile and makefolder and isfolder end
local visited = {}
local function loadVisited()
    if not hasFS() then return end
    pcall(function()
        if isfile(VISITED_FILE) then
            local d = HttpService:JSONDecode(readfile(VISITED_FILE))
            local now = os.time()
            for id, t in pairs(d) do if type(t) == "number" and now - t < VISIT_TTL then visited[id] = t end end
        end
    end)
end
local function saveVisited()
    if not hasFS() then return end
    pcall(function()
        if not isfolder(FOLDER) then makefolder(FOLDER) end
        writefile(VISITED_FILE, HttpService:JSONEncode(visited))
    end)
end
loadVisited()

-- pure filter: servers with minP..maxP players, not this server, not recently visited, room to join
local function pickServers(list, minP, maxP, myJob, seen, now)
    local out = {}
    for _, s in ipairs(list or {}) do
        local pl, mx = tonumber(s.playing), tonumber(s.maxPlayers)
        if s.id and pl and pl >= minP and pl <= maxP and s.id ~= myJob
            and not (seen[s.id] and now - seen[s.id] < VISIT_TTL) and (not mx or pl < mx) then
            out[#out + 1] = s
        end
    end
    return out
end

local function fetchPage(cursor)
    if not req then return nil, "no http request function in this executor" end
    for _, host in ipairs(HOSTS) do
        local url = ("https://%s/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100%s")
            :format(host, PLACE_ID, cursor and ("&cursor=" .. cursor) or "")
        for attempt = 1, 3 do
            local ok, res = pcall(req, { Url = url, Method = "GET" })
            if ok and res then
                local code = res.StatusCode or res.status_code
                if code == 200 then
                    local okj, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
                    if okj and type(data) == "table" then return data end
                elseif code == 429 then
                    task.wait(2.5 * attempt)
                else
                    break
                end
            else
                break
            end
        end
    end
    return nil, "server list unreachable"
end

